# Server-side Gemini API key for /api/chat (never expose to browser)
# Leave blank locally to run deterministic grounded fallback mode
GEMINI_API_KEY=

# Server-side Same-Origin Proxy targets for Next.js rewrites()
RAG_API_PROXY_TARGET=https://enterprise-rag-ops-copilot-api.onrender.com
AGENT_API_PROXY_TARGET=https://production-ai-agent-ops-api.onrender.com

# Rate limiting guardrails for /api/chat
CHAT_RATE_LIMIT_PER_MIN=15
CHAT_RATE_LIMIT_PER_DAY=60
